export default async function SavingsProfile({ params }) {
  const { id } = params;

  return (
    <div>
      <h2 className="text-2xl font-bold mb-4">Micro‑Savings Plan</h2>

      <p className="text-slate-400">Savings Plan ID: {id}</p>

      <div className="mt-6 flex flex-col gap-3">
        <a href={`/portal/savings/${id}/payments`} className="text-blue-400">
          View Payments
        </a>
        <a href={`/portal/savings/${id}/certificate`} className="text-blue-400">
          View Certificate
        </a>
      </div>
    </div>
  );
}
