export default async function StaffProfile({ params }) {
  const { id } = params;

  return (
    <div>
      <h2 className="text-2xl font-bold mb-4">Staff Profile</h2>

      <p className="text-slate-400">Staff ID: {id}</p>

      <div className="mt-6 flex flex-col gap-3">
        <a href={`/portal/staff/${id}/permissions`} className="text-blue-400">
          Manage Permissions
        </a>
      </div>

      <p className="mt-6 text-slate-500">
        Staff details will appear here once backend integration is complete.
      </p>
    </div>
  );
}
