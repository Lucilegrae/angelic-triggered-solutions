export default async function CommunityProfile({ params }) {
  const { id } = params;

  return (
    <div>
      <h2 className="text-2xl font-bold mb-4">Community Profile</h2>

      <p className="text-slate-400">Community ID: {id}</p>

      <div className="mt-6 flex flex-col gap-3">
        <a href={`/portal/communities/${id}/certificate`} className="text-blue-400">
          View Certificate
        </a>
        <a href={`/portal/communities/${id}/members`} className="text-blue-400">
          View Members
        </a>
        <a href={`/portal/communities/${id}/stakeholders`} className="text-blue-400">
          View Stakeholders
        </a>
      </div>
    </div>
  );
}
