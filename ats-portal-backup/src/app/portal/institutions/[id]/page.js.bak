export default async function InstitutionProfile({ params }) {
  const { id } = params;

  return (
    <div>
      <h2 className="text-2xl font-bold mb-4">Institution Profile</h2>

      <p className="text-slate-400">Institution ID: {id}</p>

      <div className="mt-6 flex flex-col gap-3">
        <a href={`/portal/institutions/${id}/certificate`} className="text-blue-400">
          View Certificate
        </a>
        <a href={`/portal/institutions/${id}/members`} className="text-blue-400">
          View Members
        </a>
        <a href={`/portal/institutions/${id}/stakeholders`} className="text-blue-400">
          View Stakeholders
        </a>
      </div>
    </div>
  );
}
