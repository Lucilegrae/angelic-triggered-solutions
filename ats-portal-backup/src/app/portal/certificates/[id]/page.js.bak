export default async function CertificateProfile({ params }) {
  const { id } = params;

  return (
    <div>
      <h2 className="text-2xl font-bold mb-4">Certificate Details</h2>

      <p className="text-slate-400">Certificate ID: {id}</p>

      <div className="mt-6 p-6 bg-slate-900 rounded border border-slate-800">
        <p className="text-slate-300">
          Certificate preview will appear here once backend integration is complete.
        </p>
      </div>

      <div className="mt-6 flex flex-col gap-3">
        <a href={`/portal/certificates/${id}/verify`} className="text-blue-400">
          Verify Certificate
        </a>
      </div>
    </div>
  );
}
