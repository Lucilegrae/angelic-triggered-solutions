export default async function CouncilProfile({ params }) {
  const { id } = params;

  return (
    <div>
      <h2 className="text-2xl font-bold mb-4">Council Profile</h2>

      <p className="text-slate-400">Council ID: {id}</p>

      <div className="mt-6 flex flex-col gap-3">
        <a href={`/portal/councils/${id}/certificate`} className="text-blue-400">
          View Certificate
        </a>
        <a href={`/portal/councils/${id}/communities`} className="text-blue-400">
          View Communities
        </a>
      </div>
    </div>
  );
}
