"use client";

import { useUser } from "@/components/useUser";
import MechanisationEventCreator from "@/components/MechanisationEventCreator";
import StakeholderMechanisationTimeline from "@/components/StakeholderMechanisationTimeline";

export default function MechanisationPage() {
  const { user, loading } = useUser();

  if (loading) {
    return <p className="text-slate-400">Loading…</p>;
  }

  if (!user) {
    return <p className="text-red-400">Sign in to view mechanisation timeline.</p>;
  }

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100">
      <div className="max-w-4xl mx-auto py-12 px-4">
        <h1 className="text-2xl font-semibold mb-4">
          ✦ Stakeholder Mechanisation Timeline ✦
        </h1>

        <MechanisationEventCreator stakeholderId={user.id} />

        <div className="mt-10">
          <StakeholderMechanisationTimeline stakeholderId={user.id} />
        </div>
      </div>
    </div>
  );
}
