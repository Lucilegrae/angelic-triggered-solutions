"use client";

import { useState } from "react";

export default function NewStaff() {
  const [form, setForm] = useState({});

  function updateField(e) {
    setForm({ ...form, [e.target.name]: e.target.value });
  }

  async function submitForm(e) {
    e.preventDefault();
    alert("Staff registration logic will be added here.");
  }

  return (
    <div>
      <h2 className="text-2xl font-bold mb-4">Register New Staff Member</h2>

      <form onSubmit={submitForm} className="grid grid-cols-1 gap-4 max-w-xl">
        <input name="name" placeholder="Full Name" onChange={updateField} className="p-2 bg-slate-800 rounded" />
        <input name="email" placeholder="Email Address" onChange={updateField} className="p-2 bg-slate-800 rounded" />
        <input name="role" placeholder="Role (Admin, Officer, Clerk)" onChange={updateField} className="p-2 bg-slate-800 rounded" />
        <input name="phone" placeholder="Phone Number" onChange={updateField} className="p-2 bg-slate-800 rounded" />

        <button className="bg-blue-600 px-4 py-2 rounded text-white">
          Submit
        </button>
      </form>
    </div>
  );
}
