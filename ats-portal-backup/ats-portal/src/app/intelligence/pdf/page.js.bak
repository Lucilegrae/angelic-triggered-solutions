"use client";

import { useUser } from "@/components/useUser";
import StakeholderPdfGenerator from "@/components/StakeholderPdfGenerator";

export default function StakeholderPdfPage() {
  const { user, loading } = useUser();

  if (loading) {
    return <p className="text-slate-400">Loading…</p>;
  }

  if (!user) {
    return <p className="text-red-400">Sign in to generate PDF.</p>;
  }

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100">
      <div className="max-w-4xl mx-auto py-12 px-4">
        <h1 className="text-2xl font-semibold mb-4">
          ✦ Stakeholder PDF Generator ✦
        </h1>

        <p className="text-slate-400 mb-4">
          Use your browser&apos;s Print → Save as PDF to export this report.
        </p>

        <button
          onClick={() => window.print()}
          className="px-4 py-2 bg-emerald-500 hover:bg-emerald-400 rounded text-slate-950 mb-6"
        >
          Print / Save as PDF
        </button>

        <div className="bg-white text-black p-4 rounded">
          <StakeholderPdfGenerator stakeholder={user} />
        </div>
      </div>
    </div>
  );
}
